<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- SQL cho AuditLogMapper (CN-26). namespace là tên đầy đủ của interface, id là tên hàm. -->
<mapper namespace="io.github.arielne.alp.audit.AuditLogMapper">

    <!-- employee_id: câu SELECT con đọc bảng employee theo keycloak_id (đọc chéo được, không ghi chéo);
         không có hồ sơ thì câu con không trả dòng nào và cột để rỗng.
         object_employee_id: đối tượng là nhân viên thì tìm id theo email trong object_id. Dòng audit ghi sau thao tác,
         trong cùng transaction, nên đây là email đang lưu của người đó (kể cả email vừa sửa).
         changes: chuỗi JSON ép sang kiểu jsonb của Postgres. jdbcType=VARCHAR để MyBatis gửi được giá trị null. -->
    <insert id="insert">
        INSERT INTO app.audit_log (occurred_at, employee_id, action, object_type, object_id, object_employee_id,
                                   description, ip_address, changes, request_id, source)
        VALUES (now(),
                (SELECT id FROM app.employee WHERE keycloak_id = CAST(#{keycloakId,jdbcType=VARCHAR} AS uuid)),
                #{action}, #{objectType}, #{objectId},
                CASE WHEN #{objectType} = 'EMPLOYEE' THEN (SELECT id FROM app.employee WHERE email = #{objectId}) END,
                #{description},
                #{ipAddress,jdbcType=VARCHAR}, CAST(#{changesJson,jdbcType=VARCHAR} AS jsonb),
                #{requestId,jdbcType=VARCHAR}, #{source})
    </insert>

    <!-- Điều kiện lọc dùng chung cho findPage và count (CN-23).
         <where> tự thêm chữ WHERE khi có ít nhất một điều kiện và bỏ chữ AND thừa ở đầu;
         <if> chỉ chèn điều kiện khi trường tương ứng của AuditLogFilter có giá trị.
         &gt;= và &lt; là cách viết >= và < trong file XML. -->
    <sql id="auditLogFilter">
        <where>
            <if test="employeeId != null">AND a.employee_id = #{employeeId}</if>
            <if test="systemOnly">AND a.employee_id IS NULL</if>
            <if test="fromTime != null">AND a.occurred_at &gt;= #{fromTime}</if>
            <if test="toTime != null">AND a.occurred_at &lt; #{toTime}</if>
            <if test="action != null">AND a.action = #{action}</if>
            <if test="objectType != null">AND a.object_type = #{objectType}</if>
        </where>
    </sql>

    <!-- Đọc chéo bảng employee hai lần: người làm (theo employee_id) và nhân viên là đối tượng
         (theo object_employee_id, nên đổi email sau đó vẫn hiện đúng họ tên).
         Mới nhất ở trên; cùng thời điểm thì dòng ghi sau ở trên. -->
    <select id="findPage" resultType="AuditLogRow">
        SELECT a.id, a.occurred_at, actor.full_name AS employee_name, a.action, a.object_type, a.object_id,
               target.full_name AS object_name, a.description, a.ip_address,
               CAST(a.changes AS text) AS changes_json
        FROM app.audit_log a
        LEFT JOIN app.employee actor ON actor.id = a.employee_id
        LEFT JOIN app.employee target ON target.id = a.object_employee_id
        <include refid="auditLogFilter"/>
        ORDER BY a.occurred_at DESC, a.id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT count(*)
        FROM app.audit_log a
        <include refid="auditLogFilter"/>
    </select>
</mapper>