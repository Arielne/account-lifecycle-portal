# Biến môi trường của Account Lifecycle Portal.
# Chép file này thành .env ở gốc repo rồi tự điền giá trị. File .env không được commit.
# Docker Compose và Spring Boot cùng đọc file .env, nên giá trị viết liền sau dấu =, không đặt trong dấu nháy.

# Database Supabase, lấy ở nút Connect của project, mục Session pooler.
# DB_URL viết dạng JDBC: jdbc:postgresql://<host>:5432/postgres
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Tài khoản admin đầu tiên của KeyCloak, chỉ được tạo ở lần chạy đầu tiên.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=